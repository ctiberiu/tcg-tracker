# Dependencies and build output
node_modules
dist
dist-ssr
storybook-static

# Environment files
.env
.env.local
.env.*.local
*.local

# Vercel
.vercel

# Supabase CLI link state. supabase/.temp/pooler-url contains a Postgres
# connection string WITH credentials, so this must never be committed.
# Migrations and functions under supabase/ are tracked as normal.
supabase/.temp/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*storybook.log

# Migration helper (not part of app)
scraper/run-migrations.js

# Tooling state
.devchain/
.playwright-mcp/
.claude/settings.local.json
.claude/hooks/devchain-relay.sh

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Working documents: planning PDFs, specs and scratch output live outside the
# repo, not in it. A printout is a snapshot that silently diverges from the
# source it was printed from.
*.pdf
