SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# --- Admin warnings (store auto-disabled, etc.) -----------------------------
# Always Gmail, always to you, never gated by ALERT_MODE. Costs nothing.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Admin warning recipient(s), comma-separated. Also doubles as the inbox that
# ALERT_MODE=redirect sends subscriber alerts to, and as the fallback recipient
# for alerts when the subscribers table is empty.
ALERT_EMAIL_TO=your-email@example.com

# --- Subscriber restock alerts (commercial, metered) ------------------------
# ALERT_MODE controls the ONLY path that can spend ZeptoMail credits:
#   dry      (default) render + log, send nothing, spend nothing
#   redirect send the real rendered email over Gmail to ALERT_EMAIL_TO —
#            verifies content/links/formatting without touching ZeptoMail
#   gmail    real subscribers over Gmail — the pre-ZeptoMail behaviour. Free.
#            Fine while every subscriber is someone you know; Gmail is not a
#            bulk sender and will throttle a real audience.
#   live     ZeptoMail -> the real subscribers table
# Anything unrecognised falls back to dry.
#
# Which mode is used has NO effect on what alerts later. Whether a product alerts
# is decided by the in-stock transition check in syncToSupabase: new-and-in-stock,
# or out-of-stock -> in-stock. A product first seen during a dry/redirect run is
# already in_stock=true on the next run, so there is no transition and no alert.

# Required only when ALERT_MODE=live (it refuses to send without both).
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token
ALERT_FROM=PackRadar <alerts@packradar.info>
# Defaults: emailapikey / smtp.zeptomail.eu / 587. Override for the .com DC.
# ZEPTOMAIL_USER=emailapikey
# ZEPTOMAIL_HOST=smtp.zeptomail.eu
# ZEPTOMAIL_PORT=587

# Optional: adds a List-Unsubscribe header so Gmail/Outlook show their native
# unsubscribe button. No hosted endpoint needed — replies land in this mailbox.
# ALERT_UNSUBSCRIBE_TO=unsubscribe@packradar.info

# --- Web Push restock alerts (anonymous, per-device, free) -------------------
# PUSH_MODE is INDEPENDENT of ALERT_MODE. Email is metered and push is free, so
# the intended steady state is PUSH_MODE=live with ALERT_MODE=dry or redirect.
#   dry   (default) resolve subscriptions, log what would be sent, send nothing
#   live  really notify every subscribed device
# Anything unrecognised falls back to dry.
#
# A local run with PUSH_MODE=live sends NOTHING and says so. Unlike the email
# path there is no "redirect to yourself" fallback, because there is nothing to
# redirect to: push subscribers are anonymous device rows and the operator's own
# phone is indistinguishable from a stranger's. Set ALLOW_LOCAL_PUSH=1 to
# override deliberately when verifying the real path from a laptop.
PUSH_MODE=dry
# Generate a pair with:  node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# The PUBLIC key must ALSO be set as VITE_VAPID_PUBLIC_KEY in the web app's env,
# and the two must match — a mismatch makes every subscription fail to decrypt,
# which looks like "notifications enabled but nothing ever arrives".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services use to reach you about abuse. Required.
VAPID_SUBJECT=mailto:alerts@packradar.info
