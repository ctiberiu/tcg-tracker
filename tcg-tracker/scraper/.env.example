SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# --- Admin warnings (store auto-disabled, etc.) -----------------------------
# Always Gmail, always to you, never gated by ALERT_MODE. Costs nothing.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Admin warning recipient(s), comma-separated. Also doubles as the inbox that
# ALERT_MODE=redirect sends subscriber alerts to, and as the fallback recipient
# for alerts when the subscribers table is empty.
ALERT_EMAIL_TO=your-email@example.com

# --- Subscriber restock alerts (commercial, metered) ------------------------
# ALERT_MODE controls the ONLY path that can spend ZeptoMail credits:
#   dry      (default) render + log, send nothing, spend nothing
#   redirect send the real rendered email over Gmail to ALERT_EMAIL_TO —
#            verifies content/links/formatting without touching ZeptoMail
#   live     ZeptoMail -> the real subscribers table
# Anything unrecognised falls back to dry. Neither test mode sets is_notified,
# so nothing is silently burned before you go live.
ALERT_MODE=dry

# Required only when ALERT_MODE=live (it refuses to send without both).
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token
ALERT_FROM=PackRadar <alerts@packradar.info>
# Defaults: emailapikey / smtp.zeptomail.eu / 587. Override for the .com DC.
# ZEPTOMAIL_USER=emailapikey
# ZEPTOMAIL_HOST=smtp.zeptomail.eu
# ZEPTOMAIL_PORT=587

# Optional: adds a List-Unsubscribe header so Gmail/Outlook show their native
# unsubscribe button. No hosted endpoint needed — replies land in this mailbox.
# ALERT_UNSUBSCRIBE_TO=unsubscribe@packradar.info
