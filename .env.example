VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_ALLOWED_EMAIL=your-allowed-email@example.com
# Public half of the VAPID pair used for Web Push stock alerts. Safe to ship —
# it is inlined into the bundle and is what the browser subscribes against. Must
# match VAPID_PUBLIC_KEY in the scraper's environment, or subscriptions are
# created against one key and signed with another and nothing is ever delivered.
# Leave unset to disable the notification prompt entirely (it degrades to
# "unsupported" and shows nothing, rather than erroring).
VITE_VAPID_PUBLIC_KEY=
